# Copy this file to data/runtime/realtime.env on the production server only.
# Never commit the production file or put its values in APK, browser code, or
# a settings page. Leaving the file absent keeps realtime voice safely in its
# existing "use voice recording" fallback state.

# DASHSCOPE_API_KEY=
# DASHSCOPE_WORKSPACE_ID=

# qwen3.5-omni-flash-realtime is the pilot default. These remaining values are
# optional; the server has the same defaults when they are omitted.
# DASHSCOPE_REALTIME_MODEL=qwen3.5-omni-flash-realtime
# NIANNIAN_REALTIME_TEST_USERS=admin123,admin666
# NIANNIAN_REALTIME_DAILY_LIMIT_SECONDS=900
# NIANNIAN_REALTIME_SESSION_LIMIT_SECONDS=600
